# ===== LLM（DeepSeek 开放平台 https://platform.deepseek.com）=====
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ===== Embedding（本地 Ollama，需先 pull bge-m3）=====
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ===== 切片与检索（有默认值，通常不用改）=====
CHUNK_SIZE=400
CHUNK_OVERLAP=100
TOP_K=8
MIN_SCORE=0.45

# ===== 网络代理（可选）=====
# 留空 = 直连。如需代理，格式必须是 http://host:port，不要用 socks://
LLM_PROXY=
